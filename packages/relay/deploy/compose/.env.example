# Public hostname of the relay (DNS must point here). To try it locally without TLS: RELAY_DOMAIN=http://localhost and HTTP_PORT=8080, then use ws://localhost:8080.
RELAY_DOMAIN=relay.example.com
# label=token pairs; generate tokens with: docker run --rm pi-multiplayer-relay token
RELAY_TOKENS=niels=replace-with-a-generated-token
